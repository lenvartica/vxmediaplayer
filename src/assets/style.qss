QWidget#root {
    background: #f3f3f3;
    color: #242424;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 13px;
}
QMenuBar, QMenu {
    background-color: #ffffff;
    color: #242424;
}
QMenuBar::item, QMenu::item { padding: 5px 10px; }
QMenu::item:selected, QMenuBar::item:selected {
    background: #ffe4cc;
    color: #202020;
}
QLabel#brand {
    color: #292929;
    font-size: 20px;
    font-weight: 600;
}
QLabel#trackLabel { color: #5b5b5b; }
QWidget#videoSurface {
    background: #000000;
    border: 1px solid #bcbcbc;
    border-radius: 0;
}
QWidget#playlistPanel {
    background: #ffffff;
    border: 1px solid #c9c9c9;
    border-radius: 2px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QKeySequenceEdit {
    background: #ffffff;
    border: 1px solid #bcbcbc;
    border-radius: 3px;
    padding: 5px 7px;
    color: #242424;
    selection-background-color: #f58220;
}
QListWidget {
    background: #ffffff;
    border: 0;
    outline: 0;
    padding: 3px;
}
QListWidget::item {
    padding: 7px 6px;
    color: #303030;
}
QListWidget::item:selected, QListWidget::item:hover {
    background: #ffe4cc;
    color: #242424;
}
QPushButton {
    background: #f7f7f7;
    border: 1px solid #bcbcbc;
    border-radius: 3px;
    padding: 6px 10px;
    color: #242424;
}
QPushButton:hover { background: #fff1e5; border-color: #e87918; }
QPushButton:pressed { background: #ffd2ad; }
QPushButton#primaryButton {
    background: #f58220;
    border-color: #df6e12;
    color: #ffffff;
    font-weight: 600;
}
QPushButton#primaryButton:hover { background: #e87413; }
QPushButton#transportButton {
    min-width: 38px;
    max-width: 38px;
    min-height: 38px;
    max-height: 38px;
    padding: 0;
    background: #ffffff;
    border: 1px solid #c9c9c9;
    border-radius: 19px;
}
QPushButton#transportButton:hover {
    background: #ffe4cc;
    border-color: #e9a365;
}
QPushButton#playButton {
    min-width: 42px;
    max-width: 42px;
    min-height: 42px;
    max-height: 42px;
    padding: 0;
    background: #f58220;
    border: 1px solid #df6e12;
    border-radius: 21px;
}
QPushButton#playButton:hover { background: #e87413; }
QSlider::groove:horizontal {
    height: 5px;
    background: #c9c9c9;
    border-radius: 2px;
}
QSlider::sub-page:horizontal { background: #f58220; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #f58220;
    border: 1px solid #d86b10;
    width: 13px;
    height: 13px;
    margin: -5px 0;
    border-radius: 7px;
}
QStatusBar { background: #ffffff; color: #505050; }
QToolTip {
    color: #242424;
    background: #fff7ef;
    border: 1px solid #e8a56c;
    padding: 4px;
}
